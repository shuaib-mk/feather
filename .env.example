# Meta Model API & Lavender Voice Configuration
# Required for production transcription and tool-calling agent

# Meta Model API Key (https://api.meta.ai/)
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1

# Meta Model IDs
# Muse Voice Transcribe for speech-to-text
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
# Muse Spark for agent tool-calling & vision
MUSE_SPARK_MODEL=muse-spark-1.3

# Swappable Baseten Provider (Optional - for Muse Spark Open)
# Set USE_BASETEN=true to route agent calls to meta-models/muse-spark-open-1026
USE_BASETEN=false
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://bridge.baseten.co/v1

# Backend server port
PORT=3001
