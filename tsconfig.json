{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api-src/**/*",
    "ai/**/*",
    "client/src/**/*"
  ],
  "exclude": [
    "api",
    "server",
    "node_modules",
    "dist"
  ]
}
